# Copy to .env.local. The API now runs inside this Next.js app (app/api/v1), so there is no separate
# backend to start. Server-only values (no NEXT_PUBLIC_ prefix) never reach the browser.

# --- Client ------------------------------------------------------------------------------------

# Leave unset: the client calls this app's own /api/v1. Only set it to point the UI at another API.
# NEXT_PUBLIC_API_URL=

# Stripe publishable key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_public_stripe_api_key

# Storage host allowed for next/image (your Supabase project host)
NEXT_PUBLIC_S3_BUCKET_URL=your-project-id.supabase.co

# Canonical site origin for metadata, sitemap and structured data (optional; defaults to https://tallyhawk.vercel.app)
NEXT_PUBLIC_SITE_URL=https://tallyhawk.vercel.app

# Search Console / Bing Webmaster verification tokens (optional; tags are omitted when unset)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- Server ------------------------------------------------------------------------------------

# Postgres (Neon). Same database the FastAPI backend used; run `npm run db:migrate` once.
DATABASE_URL=postgresql://user:password@ep-cool-name-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
# Connections per server instance (optional, default 5). On serverless prefer Neon's pooled URL.
# DATABASE_POOL_MAX=5

# JWT signing key. Reuse the old backend's value so existing sessions stay valid.
SECRET_KEY=your_secret_key_here

# Public origin used in password-reset emails and Stripe/QuickBooks redirects (optional; defaults to
# the request's own origin). FRONTEND_URL is still read as a fallback.
# APP_URL=https://tallyhawk.vercel.app

# Supabase Storage. A service-role key is recommended server-side; the anon key also works if the
# bucket's policies allow uploads and deletes.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_BUCKET_NAME=your_bucket_name

# Gemini (AI extraction)
GEMINI_API_KEY=your_google_api_key_here

# Currency conversion (exchangerate-api.com). Without it amounts are stored unconverted.
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key

# Stripe. Webhook endpoint: <APP_URL>/api/v1/billing/webhook
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_PRICE_ID_PRO_MONTHLY=your_stripe_price_id_for_pro_monthly
STRIPE_PRICE_ID_PRO_ANNUAL=your_stripe_price_id_for_pro_annual

# QuickBooks. Register this redirect URI in the Intuit developer portal.
QB_CLIENT_ID=your_intuit_client_id
QB_CLIENT_SECRET=your_intuit_client_secret
QB_REDIRECT_URI=http://localhost:3000/api/v1/quickbooks/callback
QB_ENVIRONMENT=sandbox

# Resend (password-reset email)
RESEND_API_KEY=your_resend_api_key
MAIL_FROM="Tallyhawk <your@domain.com>"

# Admin dashboard: username of the single manually-seeded admin row in the user table
ADMIN_USERNAME=admin
PRO_MONTHLY_PRICE_USD=5
